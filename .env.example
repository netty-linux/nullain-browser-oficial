# 100% Open Source via Ollama Cloud + Mastra
# Obtenha sua key em https://ollama.com/settings/keys ou https://openrouter.ai etc
OLLAMA_API_KEY=ollama_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo open source (troque livremente)
# Exemplos: ollama-cloud/gpt-oss:20b, ollama-cloud/gpt-oss:120b, ollama-cloud/llama3.3:70b, ollama-cloud/qwen3:32b, ollama-cloud/deepseek-v3.1:671b
MASTRA_MODEL=ollama-cloud/gpt-oss:20b

# Opcional: fallback para OpenRouter/OpenAI se quiser testar sem Ollama Cloud
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...

# ===========================================================================
# Composio — catálogo oficial e conexões via MCP
# A chave de projeto carrega toolkits/categorias somente no servidor.
# A consumer key habilita o fluxo OAuth das meta-tools do MCP Connect.
# ===========================================================================
# COMPOSIO_API_KEY=your-project-api-key
# COMPOSIO_CONSUMER_KEY=your-consumer-key
# COMPOSIO_MCP_URL=https://backend.composio.dev/api/v3/mcp

# ===========================================================================
# Geração de imagem/vídeo (WaveSpeed) — toggle Geração no composer
# Obtenha sua key em https://wavespeed.ai
# ===========================================================================
# WAVESPEED_API_KEY=ws_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================================================
# AgenticOS (Kernel/Supervisor) — modelos por camada de custo
# (defaults já cobrem tudo; defina só para override explícito)
# ===========================================================================
# Modelo do kernel/supervisor (coordenação) — default: gpt-oss:20b
# MASTRA_MODEL_KERNEL=ollama-cloud/gpt-oss:20b
# Modelo do processo de pesquisa — default: glm-5.3-flash
# MASTRA_MODEL_RESEARCH=ollama-cloud/glm-5.3-flash
# Modelo do processo de código — default: gpt-oss:120b
# MASTRA_MODEL_CODING=ollama-cloud/gpt-oss:120b
# Modelo do processo de síntese — default: deepseek-v4-flash:0731
# MASTRA_MODEL_SYNTHESIS=ollama-cloud/deepseek-v4-flash:0731

# ===========================================================================
# Adaptador AG-UI (Nullain OS — coworker no OpenBot)
# Expõe os agentes Mastra via POST /api/ag-ui/[agent] como endpoints AG-UI.
# Obrigatório para habilitar o POST AG-UI. Use o mesmo token no header
# `Authorization: Bearer <AG_UI_TOKEN>`
# ou `x-nullain-agent-token`. Gere um aleatório: openssl rand -base64 32
# (no Windows: [Convert]::ToBase64String((1..32 | % { Get-Random -Min 0 -Max 256 })))
# AG_UI_TOKEN=<gere-um-token-aleatorio-longo>

# ===========================================================================
# Gateway do OpenBot (FASE 2 — Nullain chama tools governadas pelo gateway)
# Quando a Nullain roda como coworker remote-ag-ui no OpenBot, ela NUNCA diala
# o vendor diretamente: chama de volta pelo /api/agent-tools/call com grant →
# política → audit. As tools `mcp__*` que o gateway anuncia viram tools de
# callback no adaptador AG-UI (src/mastra/agui/gateway-tools.ts).
#
# OPENBOT_TOOL_URL: endpoint de callback do OpenBot (host.docker.internal se a
#                   Nullain rodar em container; localhost se rodar no host)
# OPENBOT_CALLBACK_TOKEN: callback token per-bot emitido pelo OpenBot
#                         (/agents → Connection → Generate token)
# OPENBOT_AGENT_ID: id do coworker Nullain no OpenBot (agent_...)
# OPENBOT_TOOL_URL=http://localhost:3001/api/agent-tools/call
# OPENBOT_CALLBACK_TOKEN=
# OPENBOT_AGENT_ID=
# ===========================================================================
# ===========================================================================

# ===========================================================================
# Persistência de memória (LibSQL)
# ===========================================================================
# URL do banco LibSQL (default: file:mastra.db local)
# NULLAIN_DB_URL=file:mastra.db

# ===========================================================================
# Nullain Code — identidade e banco próprios (obrigatórios para /code)
# Gere um segredo aleatório com pelo menos 32 caracteres. O banco deve usar
# caminho absoluto e nunca pode ficar dentro de ~/nullain-code-workspace.
# ===========================================================================
# NULLAIN_AUTH_SECRET=<segredo-aleatorio-com-32-ou-mais-caracteres>
# NULLAIN_APP_DB_PATH=C:\caminho\absoluto\nullain-app.db
# NULLAIN_WORKSPACE_ROOT=D:\Nullain-Code-Workspace
# NULLAIN_AUTH_BASE_URL=http://localhost:3000
# NULLAIN_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# MASTRA_MODEL_NULLAIN_CODE=ollama-cloud/deepseek-v4-flash:0731
